# ==========================================
# NyayaSetu AI - Production Environment Config
# ==========================================

# Server Host & Port
HOST=0.0.0.0
PORT=8003

# Environment: "development" or "production"
ENVIRONMENT=production

# Allowed CORS Origins (Comma-separated, e.g., "https://nyayasetu.example.com,http://localhost:8003" or "*" for open public access)
ALLOWED_ORIGINS=*

# (Optional) Future External Integrations (Keep your real keys in .env, never commit!)
# LLM_API_KEY=
# SMS_GATEWAY_API_KEY=
# SENTRY_DSN=
